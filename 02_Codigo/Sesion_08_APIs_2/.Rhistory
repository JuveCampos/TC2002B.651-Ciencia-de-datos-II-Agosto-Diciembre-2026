library(tidyverse)
library(tidyquant)
# Función para conseguir las listas de acciones de algun índice:
get_stock_list <- function(stock_index = "SP500") {
tq_index(stock_index) %>%
select(symbol, company) %>%
arrange(symbol) %>%
mutate(label = str_c(symbol, company, sep = ", ")) %>%
select(label) %>%
slice(-1)
}
