library(httr2)
library(dplyr)
library(purrr)
library(tibble)
BASE    <- "https://api.twitterapi.io"
API_KEY <- Sys.getenv("TWITTERAPI_IO_KEY")
if (!nzchar(API_KEY)) {
stop("No encuentro TWITTERAPI_IO_KEY. Agrégala a tu .Renviron y reinicia R.")
}
library(httr2)
library(dplyr)
library(purrr)
library(tibble)
BASE    <- "https://api.twitterapi.io"
API_KEY <- Sys.getenv("TWITTERAPI_IO_KEY")
if (!nzchar(API_KEY)) {
stop("No encuentro TWITTERAPI_IO_KEY. Agrégala a tu .Renviron y reinicia R.")
}
ta_get <- function(path, params = list()) {
req <- request(BASE) |>
req_url_path_append(path) |>
req_headers("X-API-Key" = API_KEY) |>
req_url_query(!!!params) |>
req_timeout(30) |>
# reintenta ante 429 / 5xx con backoff
req_retry(max_tries = 4, backoff = \(i) 2^i)
resp <- req_perform(req)
if (resp_status(resp) != 200) {
stop("Error ", resp_status(resp), ": ", resp_body_string(resp))
}
resp_body_json(resp, simplifyVector = FALSE)
}
# La API a veces regresa los tweets en la raíz y a veces bajo $data
extraer_tweets <- function(res) {
if (!is.null(res$tweets)) return(res$tweets)
if (!is.null(res$data$tweets)) return(res$data$tweets)
list()
}
obtener_tweets <- function(user_name,
max_paginas = 5,
incluir_respuestas = FALSE,
verbose = TRUE) {
cursor <- ""
acumulado <- list()
for (i in seq_len(max_paginas)) {
params <- list(
userName       = user_name,
includeReplies = tolower(as.character(incluir_respuestas))
)
if (nzchar(cursor)) params$cursor <- cursor
res <- ta_get("twitter/user/last_tweets", params)
pagina <- extraer_tweets(res)
if (length(pagina) == 0) break
acumulado <- c(acumulado, pagina)
if (verbose) {
message(sprintf("Página %d: %d tweets (total %d)",
i, length(pagina), length(acumulado)))
}
tiene_mas <- isTRUE(res$has_next_page)
cursor    <- res$next_cursor %||% ""
if (!tiene_mas || !nzchar(cursor)) break
Sys.sleep(0.3)  # cortesía con la API
}
acumulado
}
# El campo createdAt viene como "Tue Dec 10 07:00:30 +0000 2024",
# con nombres de día y mes en inglés: hay que parsear en locale C.
parse_fecha_twitter <- function(x) {
locale_previo <- Sys.getlocale("LC_TIME")
on.exit(Sys.setlocale("LC_TIME", locale_previo), add = TRUE)
Sys.setlocale("LC_TIME", "C")
as.POSIXct(x, format = "%a %b %d %H:%M:%S %z %Y", tz = "UTC")
}
g <- function(x, ..., default = NA) {
v <- purrr::pluck(x, ...)
if (is.null(v) || length(v) == 0) default else v
}
tidy_tweets <- function(tweets) {
map_dfr(tweets, \(t) tibble(
id            = as.character(g(t, "id",     default = NA_character_)),
fecha         = parse_fecha_twitter(g(t, "createdAt", default = NA_character_)),
autor         = as.character(g(t, "author", "userName", default = NA_character_)),
texto         = as.character(g(t, "text",   default = NA_character_)),
idioma        = as.character(g(t, "lang",   default = NA_character_)),
likes         = as.integer(g(t, "likeCount",    default = NA_integer_)),
retweets      = as.integer(g(t, "retweetCount", default = NA_integer_)),
respuestas    = as.integer(g(t, "replyCount",   default = NA_integer_)),
citas         = as.integer(g(t, "quoteCount",   default = NA_integer_)),
vistas        = as.integer(g(t, "viewCount",    default = NA_integer_)),
marcadores    = as.integer(g(t, "bookmarkCount",default = NA_integer_)),
es_respuesta  = isTRUE(g(t, "isReply", default = FALSE)),
url           = as.character(g(t, "url", default = NA_character_))
))
}
crudos <- obtener_tweets("AnthropicAI", max_paginas = 3)
anthropic <- tidy_tweets(crudos) |>
arrange(desc(fecha)) |>
distinct(id, .keep_all = TRUE)
print(anthropic, n = 10)
# Ejemplo de análisis rápido
anthropic |>
mutate(semana = as.Date(cut(fecha, "week"))) |>
summarise(
n_tweets      = n(),
likes_medios  = mean(likes, na.rm = TRUE),
.by = semana
) |>
arrange(semana)
anthropic
View(anthropic)
