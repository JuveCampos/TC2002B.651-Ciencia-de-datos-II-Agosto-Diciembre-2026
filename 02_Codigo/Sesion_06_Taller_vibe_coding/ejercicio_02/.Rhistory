# ============================================================================
# Consultas sobre mr_rib_eye.db
# Sesión 06 - Taller de vibe coding, ejercicio 02
#
# Se responden cinco preguntas de negocio sobre la cadena de restaurantes
# Mr. Rib Eye. La lógica de consulta se escribe en SQL y se envía a la base
# con DBI::dbGetQuery(); R se reserva para el formato de salida, la gráfica y
# la interpretación. dbplyr aparece en la última sección como puente entre la
# sintaxis de dplyr y el SQL que genera.
#
# El proyecto ejercicio_02.Rproj fija el directorio de trabajo en esta
# carpeta, de modo que la ruta relativa a la base siempre resuelve.
# ============================================================================
library(DBI)
library(RSQLite)
library(dbplyr)
library(dplyr)
library(tidyr)
library(ggplot2)
library(scales)
# ---------------------------------------------------------------------------
# 0. Conexión a la base
# ---------------------------------------------------------------------------
ruta_base <- "mr_rib_eye.db"
stopifnot(file.exists(ruta_base))
con <- dbConnect(RSQLite::SQLite(), ruta_base)
# Inventario de tablas y vistas disponibles
print(dbListTables(con))
# Carpeta donde se guardan las figuras
dir.create("figuras", showWarnings = FALSE)
# ---------------------------------------------------------------------------
# 1. ¿Cuáles son las diez ventas de mayor monto y en qué fecha ocurrieron?
#
# Se unen las tres tablas para que el resultado sea legible: la venta sola
# solo trae claves numéricas de sucursal y de empleado.
# ---------------------------------------------------------------------------
sql_top_ventas <- "
SELECT v.id_venta,
date(v.fecha_hora) AS fecha,
time(v.fecha_hora) AS hora,
s.nombre_sucursal,
e.nombre_completo  AS mesero,
v.num_comensales,
v.total_venta,
v.propina,
v.metodo_pago
FROM ventas v
JOIN sucursales s ON v.id_sucursal = s.id_sucursal
JOIN empleados  e ON v.id_empleado = e.id_empleado
ORDER BY v.total_venta DESC
LIMIT 10;
"
top_ventas <- dbGetQuery(con, sql_top_ventas) %>% as_tibble()
print(top_ventas, n = 10, width = Inf)
# ---------------------------------------------------------------------------
# 2. ¿Cómo se reparten las 88 ventas entre efectivo, tarjeta y transferencia,
#    en número de tickets y en pesos?
#
# Las subconsultas del SELECT calculan los porcentajes contra el total
# general, para no tener que dividir después en R.
# ---------------------------------------------------------------------------
sql_metodos_pago <- "
SELECT metodo_pago,
COUNT(*)                AS num_tickets,
SUM(total_venta)        AS monto,
ROUND(AVG(total_venta), 2) AS ticket_promedio,
ROUND(100.0 * COUNT(*) /
(SELECT COUNT(*) FROM ventas), 1)         AS pct_tickets,
ROUND(100.0 * SUM(total_venta) /
(SELECT SUM(total_venta) FROM ventas), 1) AS pct_monto
FROM ventas
GROUP BY metodo_pago
ORDER BY monto DESC;
"
metodos_pago <- dbGetQuery(con, sql_metodos_pago) %>% as_tibble()
print(metodos_pago, width = Inf)
# El cálculo ya viene resuelto desde SQL. El paso a formato largo es
# exclusivamente para graficar las dos métricas en paneles separados.
metodos_largo <- metodos_pago %>%
select(metodo_pago, num_tickets, monto) %>%
pivot_longer(
cols = c(num_tickets, monto),
names_to = "metrica",
values_to = "valor"
) %>%
mutate(
metrica = recode(
metrica,
num_tickets = "Número de tickets",
monto = "Ingresos (pesos)"
),
metrica = factor(
metrica,
levels = c("Número de tickets", "Ingresos (pesos)")
),
etiqueta = if_else(
metrica == "Número de tickets",
comma(valor, accuracy = 1),
dollar(valor, accuracy = 1, big.mark = ",")
)
)
# Paleta propia del ejercicio: guinda de la carne, verde del billete y
# ámbar de la transferencia. No se usa el azul institucional por defecto.
colores_pago <- c(
"Tarjeta"       = "#8B1E3F",
"Efectivo"      = "#2F6F4E",
"Transferencia" = "#C77D2E"
)
grafica_pagos <- ggplot(
metodos_largo,
aes(x = reorder(metodo_pago, valor), y = valor, fill = metodo_pago)
) +
geom_col(width = 0.65) +
geom_text(aes(label = etiqueta), hjust = -0.12, size = 3.6) +
coord_flip() +
facet_wrap(~ metrica, scales = "free_x") +
scale_fill_manual(values = colores_pago) +
scale_y_continuous(expand = expansion(mult = c(0, 0.22))) +
labs(
title = "La tarjeta concentra la mitad de los tickets y 56% de los pesos",
subtitle = paste0(
"Mr. Rib Eye, 88 ventas registradas entre el 1 de marzo y el 15 de ",
"agosto de 2024"
),
x = NULL,
y = NULL,
caption = "Fuente: base mr_rib_eye.db. Cálculos propios."
) +
theme_minimal(base_size = 12) +
theme(
legend.position = "none",
panel.grid.major.y = element_blank(),
panel.grid.minor = element_blank(),
axis.text.x = element_blank(),
strip.text = element_text(face = "bold"),
plot.title = element_text(face = "bold"),
plot.caption = element_text(size = 9, colour = "#666666", hjust = 0)
)
print(grafica_pagos)
ggsave(
filename = "figuras/02_metodos_pago.png",
plot = grafica_pagos,
width = 9,
height = 4.5,
dpi = 300
)
# ---------------------------------------------------------------------------
# 3. ¿Qué sucursal genera más ingresos y cuál tiene el ticket promedio más
#    alto?
#
# Se agregan las dos métricas en la misma consulta para poder compararlas
# renglón por renglón.
# ---------------------------------------------------------------------------
sql_sucursales <- "
SELECT s.nombre_sucursal,
s.zona,
COUNT(v.id_venta)          AS num_tickets,
SUM(v.total_venta)         AS ingresos,
ROUND(AVG(v.total_venta), 2) AS ticket_promedio,
ROUND(SUM(v.total_venta) * 1.0 /
SUM(v.num_comensales), 2) AS gasto_por_comensal
FROM sucursales s
JOIN ventas v ON v.id_sucursal = s.id_sucursal
GROUP BY s.id_sucursal, s.nombre_sucursal, s.zona
ORDER BY ingresos DESC;
"
sucursales_desempeno <- dbGetQuery(con, sql_sucursales) %>% as_tibble()
print(sucursales_desempeno, width = Inf)
lider_ingresos <- sucursales_desempeno %>% slice_max(ingresos, n = 1)
lider_ticket <- sucursales_desempeno %>% slice_max(ticket_promedio, n = 1)
print(paste0(
"Más ingresos: ", lider_ingresos$nombre_sucursal, " con ",
dollar(lider_ingresos$ingresos, accuracy = 1, big.mark = ","),
" en ", lider_ingresos$num_tickets, " tickets."
))
print(paste0(
"Ticket promedio más alto: ", lider_ticket$nombre_sucursal, " con ",
dollar(lider_ticket$ticket_promedio, accuracy = 1, big.mark = ","),
" por venta."
))
# La pregunta supone que las dos respuestas difieren. Se verifica con los
# datos en lugar de darlo por hecho.
if (lider_ingresos$nombre_sucursal == lider_ticket$nombre_sucursal) {
print(paste0(
"Advertencia: en esta base ambas respuestas coinciden en ",
lider_ticket$nombre_sucursal,
". El orden por ingresos y por ticket promedio es idéntico en las seis ",
"sucursales, así que aquí el volumen no compite contra el ticket."
))
}
# ---------------------------------------------------------------------------
# 4. ¿Las propinas son proporcionalmente más generosas con tarjeta que con
#    efectivo?
#
# Se calculan dos versiones del porcentaje porque responden cosas distintas:
#   pct_ponderado -> propina total sobre venta total (pesa más los tickets
#                    grandes)
#   pct_promedio  -> promedio simple del porcentaje de cada ticket (cada
#                    venta cuenta igual)
# ---------------------------------------------------------------------------
sql_propinas <- "
SELECT metodo_pago,
COUNT(*)         AS num_tickets,
SUM(total_venta) AS ventas,
SUM(propina)     AS propinas,
ROUND(100.0 * SUM(propina) / SUM(total_venta), 2) AS pct_ponderado,
ROUND(AVG(100.0 * propina / total_venta), 2)      AS pct_promedio,
ROUND(MIN(100.0 * propina / total_venta), 2)      AS pct_minimo,
ROUND(MAX(100.0 * propina / total_venta), 2)      AS pct_maximo
FROM ventas
GROUP BY metodo_pago
ORDER BY pct_ponderado DESC;
"
propinas_metodo <- dbGetQuery(con, sql_propinas) %>% as_tibble()
print(propinas_metodo, width = Inf)
brecha_pp <- propinas_metodo %>%
filter(metodo_pago %in% c("Tarjeta", "Efectivo")) %>%
summarise(
brecha = pct_ponderado[metodo_pago == "Tarjeta"] -
pct_ponderado[metodo_pago == "Efectivo"]
) %>%
pull(brecha)
print(paste0(
"Brecha tarjeta menos efectivo: ", round(brecha_pp, 2),
" puntos porcentuales. La diferencia es despreciable, así que la ",
"hipótesis de que la tarjeta afloja la mano no se sostiene aquí."
))
# ---------------------------------------------------------------------------
# 5. ¿Cuánto ingreso genera cada mesero por peso de salario base recibido?
#
# Las expresiones de tabla común (CTE) agregan ventas y nómina por separado
# ANTES de unirlas al catálogo de empleados. Si se unieran las tres tablas
# directamente, cada venta se repetiría por cada pago de nómina y los montos
# quedarían inflados.
# ---------------------------------------------------------------------------
sql_productividad <- "
WITH ventas_por_mesero AS (
SELECT id_empleado,
COUNT(*)         AS tickets,
SUM(total_venta) AS ingresos
FROM ventas
GROUP BY id_empleado
),
nomina_por_mesero AS (
SELECT id_empleado,
COUNT(*)          AS pagos,
SUM(salario_base) AS salario_base_pagado,
SUM(total_neto)   AS neto_pagado
FROM nomina
GROUP BY id_empleado
)
SELECT e.id_empleado,
e.nombre_completo,
s.nombre_sucursal,
COALESCE(vm.tickets, 0)  AS tickets,
COALESCE(vm.ingresos, 0) AS ingresos,
nm.pagos,
nm.salario_base_pagado,
ROUND(vm.ingresos * 1.0 / nm.salario_base_pagado, 2)
AS ingreso_por_peso,
ROUND(vm.ingresos * 1.0 /
(nm.salario_base_pagado / nm.pagos), 2)
AS ingreso_por_peso_quincena
FROM empleados e
JOIN sucursales s ON e.id_sucursal = s.id_sucursal
LEFT JOIN ventas_por_mesero vm ON vm.id_empleado = e.id_empleado
LEFT JOIN nomina_por_mesero nm ON nm.id_empleado = e.id_empleado
WHERE e.puesto = 'Mesero'
ORDER BY ingreso_por_peso IS NULL, ingreso_por_peso DESC;
"
productividad <- dbGetQuery(con, sql_productividad) %>% as_tibble()
print(productividad, n = Inf, width = Inf)
# ---------------------------------------------------------------------------
# 5b. Advertencias sobre la cobertura de la nómina
#
# El indicador anterior solo se puede calcular para los meseros que aparecen
# en la tabla nomina, y el número de quincenas pagadas no es igual entre
# ellos. Ambas cosas se cuantifican antes de interpretar el resultado.
# ---------------------------------------------------------------------------
sql_cobertura <- "
SELECT COUNT(*) AS meseros,
SUM(CASE WHEN EXISTS (SELECT 1 FROM nomina n
WHERE n.id_empleado = e.id_empleado)
THEN 1 ELSE 0 END) AS con_nomina,
SUM(CASE WHEN EXISTS (SELECT 1 FROM ventas v
WHERE v.id_empleado = e.id_empleado)
THEN 1 ELSE 0 END) AS con_ventas
FROM empleados e
WHERE e.puesto = 'Mesero';
"
cobertura <- dbGetQuery(con, sql_cobertura) %>% as_tibble()
print(paste0(
"De ", cobertura$meseros, " meseros, ", cobertura$con_ventas,
" registran ventas y solo ", cobertura$con_nomina,
" tienen pagos de nómina. El indicador de productividad queda indefinido ",
"para el resto."
))
print(paste0(
"Además, las quincenas pagadas van de ",
min(productividad$pagos, na.rm = TRUE), " a ",
max(productividad$pagos, na.rm = TRUE),
". Comparar ingreso_por_peso entre meseros con distinto número de pagos ",
"castiga a quien tiene más nómina registrada; para eso está la columna ",
"ingreso_por_peso_quincena, que normaliza por quincena."
))
# ---------------------------------------------------------------------------
# 6. Puente entre dplyr y SQL con dbplyr
#
# tbl() crea una tabla perezosa: no trae los datos, construye la consulta.
# show_query() muestra el SQL que dbplyr genera y collect() lo ejecuta.
# Sirve para comprobar que el SQL escrito a mano en la pregunta 2 y la
# traducción automática de dplyr producen el mismo resultado.
# ---------------------------------------------------------------------------
ventas_tbl <- tbl(con, "ventas")
consulta_perezosa <- ventas_tbl %>%
group_by(metodo_pago) %>%
summarise(
num_tickets = n(),
monto = sum(total_venta, na.rm = TRUE)
) %>%
arrange(desc(monto))
# SQL que dbplyr genera a partir del pipeline anterior
show_query(consulta_perezosa)
# Ejecución y comparación contra el resultado de la pregunta 2
resultado_dbplyr <- consulta_perezosa %>% collect()
print(resultado_dbplyr)
comparable_sql <- metodos_pago %>%
select(metodo_pago, num_tickets, monto) %>%
arrange(metodo_pago)
comparable_dbplyr <- resultado_dbplyr %>%
select(metodo_pago, num_tickets, monto) %>%
arrange(metodo_pago)
coinciden <- all.equal(comparable_sql, comparable_dbplyr)
print(paste0("¿SQL a mano y dbplyr coinciden?: ", isTRUE(coinciden)))
# ---------------------------------------------------------------------------
# 7. Cierre de la conexión
# ---------------------------------------------------------------------------
dbDisconnect(con)
